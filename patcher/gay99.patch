From b30be3cb4fee38c87394e9298a3acd02fa6e85ba Mon Sep 17 00:00:00 2001
From: picasso09 <119201284+picasso09@users.noreply.github.com>
Date: Mon, 30 Dec 2024 17:01:54 +0000
Subject: [PATCH] gki-android12-9: Optimized CC for MT6789V/CD

Signed-off-by: picasso09 <119201284+picasso09@users.noreply.github.com>

Date:      Mon Dec 30 17:01:54 2024 +0000
Change-Id: 40d361a5010277a5a59113e1e73780fbd13e9dbd
---
 arch/arm64/Makefile | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index 07c5e0fc006f..958f1c499636 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -44,6 +44,14 @@ ifeq ($(CONFIG_BROKEN_GAS_INST),y)
 $(warning Detected assembler with broken .inst; disassembly will be unreliable)
 endif
 
+# Optimize MT6789V/CD
+KBUILD_CFLAGS   += -march=armv8.2-a+crypto+fp16+dotprod+nosve -mcpu=cortex-a76
+KBUILD_AFLAGS   += -march=armv8.2-a+crypto+fp16+dotprod+nosve -mcpu=cortex-a55
+
+ifeq ($(CONFIG_LD_IS_LLD), y)
+KBUILD_LDFLAGS  += -mllvm -mcpu=cortex-a76
+endif
+
 KBUILD_CFLAGS	+= -mgeneral-regs-only	\
 		   $(compat_vdso) $(cc_has_k_constraint)
 KBUILD_CFLAGS	+= $(call cc-disable-warning, psabi)
